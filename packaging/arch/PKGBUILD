# Maintainer: narl3yyy-svg
#
# Builds from this checkout of the repository:
#   cd packaging/arch && makepkg -si
pkgname=lxscp
pkgver=0.2.0
pkgrel=1
pkgdesc="WinSCP-style graphical SFTP client"
arch=('any')
url="https://github.com/narl3yyy-svg/LXSCP"
license=('MIT')
depends=('python' 'python-pyqt6' 'python-paramiko' 'python-keyring')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=()

_srcroot() {
    realpath "$startdir/../.."
}

build() {
    rm -rf "$srcdir/lxscp"
    mkdir -p "$srcdir/lxscp"
    cd "$(_srcroot)"
    cp -r lxscp pyproject.toml README.md LICENSE packaging "$srcdir/lxscp/"
    cd "$srcdir/lxscp"
    find . -name __pycache__ -prune -exec rm -rf {} +
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/lxscp"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 packaging/lxscp.desktop "$pkgdir/usr/share/applications/lxscp.desktop"
    for size in 16 32 48 64 128 256; do
        install -Dm644 "lxscp/icons/lxscp-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/lxscp.png"
    done
    install -Dm644 lxscp/icons/lxscp.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/lxscp.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
